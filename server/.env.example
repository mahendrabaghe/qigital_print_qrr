# ===== Server environment =====
NODE_ENV=development
PORT=4000

# MongoDB connection. In production, allow Render outbound IP ranges in Atlas Network Access.
# - Production: use MongoDB Atlas, e.g. mongodb+srv://user:pass@cluster/printshop
# - Local: mongodb://127.0.0.1:27017/printshop
# - Development fallback (ephemeral, data lost on restart): memory://
MONGODB_URI=memory://

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# First admin account (seeded automatically on first boot, change password after login)
ADMIN_EMAIL=admin@printshop.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Shop Owner

# Shop
SHOP_NAME=My Digital Print Shop

# Public base URL of the FRONTEND (used to build QR code links).
# Production: use the public HTTPS site so customers can scan from any network.
# Local development only: use the shop PC's LAN IP and Vite port for same-Wi-Fi scans.
PUBLIC_BASE_URL=http://localhost:5173

# Files
MAX_FILE_SIZE_MB=25
FILE_RETENTION_HOURS=24
FILE_STORAGE_DIR=./storage

# Sessions / QR
SESSION_TTL_HOURS=2
QR_TTL_DAYS=30

# Printing: demo (simulated printing, no agent needed) or real (requires print-agent)
PRINT_MODE=demo
# Delay used by demo mode when simulating a print job (ms)
DEMO_DELAY_MS=2500

# CORS: comma-separated list of allowed origins. Empty = allow all (dev only).
CORS_ORIGINS=
